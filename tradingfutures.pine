//@version=6

indicator("TradingIndicator", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_polylines_count=100)

// --- Types & Methods ---
type GapObject
    float top_val
    float btm_val
    float avg_val
    int start_t
    box b
    line[] lines
    label l

type EhpdaObj
    line lvl
    label lbl

f_delete_gap(GapObject obj) =>
    if not na(obj)
        if not na(obj.b)
            box.delete(obj.b)
        for l in obj.lines
            if not na(l)
                line.delete(l)
        if not na(obj.l)
            label.delete(obj.l)

f_get_line_style(string s) => s=="solid (—)" or s=="Solid" ? line.style_solid : s=="dotted (...)" or s=="Dotted" ? line.style_dotted : line.style_dashed
f_get_size(string s) => s=="tiny" ? size.tiny : s=="small" ? size.small : s=="normal" ? size.normal : size.large

// --- Settings ---
grp_ma = "Moving Averages Settings", i_showMas = input.bool(false, "Show EMA/SMA", group=grp_ma)
i_smaColor = input.color(#42bda8,"SMA Color",inline="sma_main",group=grp_ma), i_smaLen = input.int(200,minval=1,title="SMA Length",inline="sma_main",group=grp_ma)
i_emaColor = input.color(#5b9cf6,"EMA Color",inline="ema_main",group=grp_ma), i_emaLen = input.int(50,minval=1,title="EMA Length",inline="ema_main",group=grp_ma)

grp_nwog = "NWOG Settings", i_showNwog = input.bool(true,"Show NWOG",group=grp_nwog), i_nwogCount = input.int(5,"Amount",minval=1,group=grp_nwog), i_nwogLines = input.string("CE","Show Lines",options=["None","CE","Quadrant"],group=grp_nwog), i_nwogColorBull = input.color(color.new(#5b9cf6, 90),"Gaps Colors",inline="nwog_col",group=grp_nwog), i_nwogColorBear = input.color(color.new(#5b9cf6, 90),"",inline="nwog_col",group=grp_nwog), i_nwogBorderCol = input.color(color.new(#5b9cf6, 90),"Border Color",inline="nwog_b",group=grp_nwog), i_nwogBorderStyle = input.string("solid (—)","Style",options=["solid (—)","dotted (...)","dashed (---)"],inline="nwog_b",group=grp_nwog), i_nwogBorderWidth = input.int(1,"Width",minval=0,inline="nwog_b",group=grp_nwog), i_nwogLineCol = input.color(color.new(#5b9cf6, 90),"Lines color",inline="nwog_l",group=grp_nwog), i_nwogLineStyle = input.string("dashed (---)","Style",options=["solid (—)","dotted (...)","dashed (---)"],inline="nwog_l",group=grp_nwog), i_nwogLineWidth = input.int(1,"Width",minval=1,inline="nwog_l",group=grp_nwog)
grp_ndog = "NDOG Settings", i_showNdog = input.bool(true,"Show NDOG",group=grp_ndog), i_ndogCount = input.int(5,"Amount",minval=1,group=grp_ndog), i_ndogLines = input.string("CE","Show Lines",options=["None","CE","Quadrant"],group=grp_ndog), i_ndogColorBull = input.color(color.new(#ba68c8, 90),"Gaps Colors",inline="ndog_col",group=grp_ndog), i_ndogColorBear = input.color(color.new(#ba68c8, 90),"",inline="ndog_col",group=grp_ndog), i_ndogBorderCol = input.color(color.new(#ba68c8, 90),"Border Color",inline="ndog_b",group=grp_ndog), i_ndogBorderStyle = input.string("solid (—)","Style",options=["solid (—)","dotted (...)","dashed (---)"],inline="ndog_b",group=grp_ndog), i_ndogBorderWidth = input.int(1,"Width",minval=0,inline="ndog_b",group=grp_ndog), i_ndogLineCol = input.color(color.new(#ba68c8, 90),"Lines color",inline="ndog_l",group=grp_ndog), i_ndogLineStyle = input.string("dashed (---)","Style",options=["solid (—)","dotted (...)","dashed (---)"],inline="ndog_l",group=grp_ndog), i_ndogLineWidth = input.int(1,"Width",minval=1,inline="ndog_l",group=grp_ndog)

grp_gen = "General Settings", i_offset = input.int(50,"Label Offset (Bars)",group=grp_gen)
grp_rthg = "RTHG Settings", i_showRthg = input.bool(true,"Show Regular Trading Hours Gap",group=grp_rthg), i_rthgCount = input.int(6,"How many RTH gaps to show",minval=1,group=grp_rthg), i_rthgLines = input.string("CE","Show RTH Gap Lines",options=["None","CE","Quadrant"],group=grp_rthg), i_rthgColor = input.color(color.new(#00b9d0,90),"RTH Gap color",group=grp_rthg), i_rthgTxtColor = input.color(#008f9c,"Text Color",inline="rthg_t",group=grp_rthg), i_rthgText = input.string("RTHG","Label",inline="rthg_t",group=grp_rthg), i_rthgTxtSize = input.string("tiny","Size",options=["tiny","small","normal","large"],inline="rthg_t",group=grp_rthg), i_rthgBorderCol = input.color(#00b9d0,"RTHG Border Color",inline="rthg_b",group=grp_rthg), i_rthgBorderStyle = input.string("solid (—)","Style",options=["solid (—)","dotted (...)","dashed (---)"],inline="rthg_b",group=grp_rthg), i_rthgBorderWidth = input.int(0,"Width",minval=0,inline="rthg_b",group=grp_rthg), i_rthgLineCol = input.color(#00b9d0,"RTHG Lines color",inline="rthg_l",group=grp_rthg), i_rthgLineStyle = input.string("dashed (---)","Style",options=["solid (—)","dotted (...)","dashed (---)"],inline="rthg_l",group=grp_rthg), i_rthgLineWidth = input.int(1,"Width",minval=1,inline="rthg_l",group=grp_rthg), i_rthSess = input.session("0930-1615","Market Hours (EST)",group=grp_rthg,tooltip="RTH session hours in EST/EDT")
grp_ny = "NY Midnight Open Settings", i_showNy = input.bool(true,"Show NY Midnight Open",group=grp_ny)

// --- HTF Data Fetchers ---
f_fetch_htf_gaps(int count) =>
    float[] tops = array.new_float(), float[] btms = array.new_float(), int[] tms = array.new_int(), bool[] bulls = array.new_bool()
    for i = 0 to 15
        if na(close[i+1])
            break
        top = math.max(close[i+1], open[i]), btm = math.min(close[i+1], open[i])
        if top != btm
            array.push(tops, top), array.push(btms, btm), array.push(tms, time[i]), array.push(bulls, open[i] > close[i+1])
        if array.size(tops) >= count
            break
    [tops, btms, tms, bulls]

f_fetch_rth_arrays() =>
    var float[] tops = array.new<float>(0), var float[] btms = array.new<float>(0), var int[] tms = array.new<int>(0)
    in_r = not na(time(timeframe.period, i_rthSess + ":23456", "America/New_York"))
    var float prev_c = na
    if in_r[1] and not in_r
        prev_c := close[1]
    if in_r and not in_r[1] and not na(prev_c)
        top = math.max(prev_c, open), btm = math.min(prev_c, open)
        if top != btm
            array.unshift(tops, top), array.unshift(btms, btm), array.unshift(tms, time)
            if array.size(tops) > 10
                array.pop(tops), array.pop(btms), array.pop(tms)
    [tops, btms, tms]

[w_tops, w_btms, w_tms, w_bulls] = request.security(syminfo.tickerid, "W", f_fetch_htf_gaps(10))
[d_tops, d_btms, d_tms, d_bulls] = request.security(syminfo.tickerid, "D", f_fetch_htf_gaps(10))
[r_tops, r_btms, r_tms]          = request.security(syminfo.tickerid, "15", f_fetch_rth_arrays())

// --- GAP Engine ---
show_draws = not timeframe.isdwm // Master switch: Hides drawings on D, W, M timeframes

f_create_gap(top_val, btm_val, start_t, lines_type, bg_col, border_col, border_style, border_w, line_col, line_style, line_w, txt, txt_col, txt_size) =>
    avg_val = math.avg(top_val, btm_val), lines = array.new<line>(), b_col = border_w == 0 ? color.new(border_col, 100) : border_col
    b = box.new(left=start_t, top=top_val, right=start_t+1, bottom=btm_val, xloc=xloc.bar_time, extend=extend.right, bgcolor=bg_col, border_color=b_col, border_style=f_get_line_style(border_style), border_width=border_w)
    if lines_type == "CE"
        array.push(lines, line.new(start_t, avg_val, start_t+1, avg_val, xloc=xloc.bar_time, extend=extend.right, color=line_col, style=f_get_line_style(line_style), width=line_w))
    else if lines_type == "Quadrant"
        array.push(lines, line.new(start_t, btm_val+(top_val-btm_val)*0.25, start_t+1, btm_val+(top_val-btm_val)*0.25, xloc=xloc.bar_time, extend=extend.right, color=line_col, style=f_get_line_style(line_style), width=line_w)), array.push(lines, line.new(start_t, avg_val, start_t+1, avg_val, xloc=xloc.bar_time, extend=extend.right, color=line_col, style=f_get_line_style(line_style), width=line_w)), array.push(lines, line.new(start_t, btm_val+(top_val-btm_val)*0.75, start_t+1, btm_val+(top_val-btm_val)*0.75, xloc=xloc.bar_time, extend=extend.right, color=line_col, style=f_get_line_style(line_style), width=line_w))
    l = txt != "" ? label.new(time, avg_val, txt, xloc=xloc.bar_time, yloc=yloc.price, color=color(na), style=label.style_label_left, textcolor=txt_col, size=f_get_size(txt_size)) : label.new(na, na, "")
    GapObject.new(top_val, btm_val, avg_val, start_t, b, lines, l)

var ehpda_array = array.new<EhpdaObj>()
if barstate.isfirst
    for i = 0 to i_ndogCount
        array.push(ehpda_array, EhpdaObj.new(line.new(na,na,na,na,color=#787b86,style=line.style_dashed,extend=extend.none,xloc=xloc.bar_time), label.new(na,na,"",color=color(na),style=label.style_label_left,textcolor=#787b86,size=size.tiny,xloc=xloc.bar_time)))

f_update_ehpda(array<GapObject> gaps) =>
    if array.size(gaps) > 1
        avg_arr = array.new<float>()
        for g in gaps
            array.push(avg_arr, g.avg_val)
        idx = array.sort_indices(avg_arr)
        for i = 0 to array.size(gaps) - 2
            g1 = array.get(gaps, array.get(idx, i)), g2 = array.get(gaps, array.get(idx, i+1)), ehpda_avg = math.avg(g1.top_val, g2.btm_val), e_obj = array.get(ehpda_array, i)
            line.set_xy1(e_obj.lvl, g1.start_t, ehpda_avg), line.set_xy2(e_obj.lvl, time, ehpda_avg)
            label.set_xy(e_obj.lbl, time, ehpda_avg), label.set_text(e_obj.lbl, "EHPDA")
        if array.size(gaps) - 1 < array.size(ehpda_array)
            for i = array.size(gaps) - 1 to array.size(ehpda_array) - 1
                e_obj = array.get(ehpda_array, i)
                line.set_xy1(e_obj.lvl, na, na), line.set_xy2(e_obj.lvl, na, na), label.set_xy(e_obj.lbl, na, na)

var nwog_gaps = array.new<GapObject>(), var ndog_gaps = array.new<GapObject>(), var rthg_gaps = array.new<GapObject>()

f_draw_htf_gaps(float[] tops, float[] btms, int[] tms, bool[] bulls, int count, string lines_type, color col_bull, color col_bear, color border_col, string border_style, int border_w, color line_col, string line_style, int line_w) =>
    GapObject[] gaps = array.new<GapObject>()
    if not na(tops) and not na(btms) and not na(tms) and not na(bulls)
        limit = math.min(count, array.size(tops))
        if limit > 0
            for i = 0 to limit - 1
                gaps.push(f_create_gap(array.get(tops, i), array.get(btms, i), array.get(tms, i), lines_type, array.get(bulls, i) ? col_bull : col_bear, border_col, border_style, border_w, line_col, line_style, line_w, "", color(na), "tiny"))
    gaps

if (barstate.islast or timeframe.change("W")) and i_showNwog and show_draws
    for g in nwog_gaps
        f_delete_gap(g)
    array.clear(nwog_gaps)
    nwog_gaps := f_draw_htf_gaps(w_tops, w_btms, w_tms, w_bulls, i_nwogCount, i_nwogLines, i_nwogColorBull, i_nwogColorBear, i_nwogBorderCol, i_nwogBorderStyle, i_nwogBorderWidth, i_nwogLineCol, i_nwogLineStyle, i_nwogLineWidth)

if (barstate.islast or timeframe.change("D")) and i_showNdog and show_draws
    for g in ndog_gaps
        f_delete_gap(g)
    array.clear(ndog_gaps)
    ndog_gaps := f_draw_htf_gaps(d_tops, d_btms, d_tms, d_bulls, i_ndogCount, i_ndogLines, i_ndogColorBull, i_ndogColorBear, i_ndogBorderCol, i_ndogBorderStyle, i_ndogBorderWidth, i_ndogLineCol, i_ndogLineStyle, i_ndogLineWidth)
    f_update_ehpda(ndog_gaps)

if (barstate.islast or timeframe.change("15")) and i_showRthg and show_draws
    for g in rthg_gaps
        f_delete_gap(g)
    array.clear(rthg_gaps)
    if not na(r_tops) and not na(r_btms) and not na(r_tms)
        limit = math.min(i_rthgCount, array.size(r_tops))
        if limit > 0
            for i = 0 to limit - 1
                tm = array.get(r_tms, i), d = dayofweek(tm, "America/New_York"), ds = d == dayofweek.monday ? "MON" : d == dayofweek.tuesday ? "TUE" : d == dayofweek.wednesday ? "WED" : d == dayofweek.thursday ? "THU" : d == dayofweek.friday ? "FRI" : ""
                txt = ds != "" ? i_rthgText + " " + ds + "/" + str.format_time(tm, "dd", "America/New_York") : ""
                g = f_create_gap(array.get(r_tops, i), array.get(r_btms, i), tm, i_rthgLines, i_rthgColor, i_rthgBorderCol, i_rthgBorderStyle, i_rthgBorderWidth, i_rthgLineCol, i_rthgLineStyle, i_rthgLineWidth, txt, i_rthgTxtColor, i_rthgTxtSize)
                if i > 0
                    box.set_bgcolor(g.b, na), box.set_border_color(g.b, na)
                array.push(rthg_gaps, g)

// --- Offsets & NY Midnight ---
var label ny_lbl = label.new(na, na, "", xloc=xloc.bar_time, yloc=yloc.price, color=color(na), style=label.style_label_left)
if barstate.islast
    time_offset = time + (i_offset * 60000 * timeframe.multiplier)
    if array.size(rthg_gaps) > 0
        for i = 0 to array.size(rthg_gaps) - 1
            if not na(array.get(rthg_gaps, i).l)
                label.set_x(array.get(rthg_gaps, i).l, time_offset)
    if array.size(ndog_gaps) > 1
        limit = math.min(array.size(ndog_gaps) - 1, array.size(ehpda_array))
        if limit > 0
            for i = 0 to limit - 1
                e_obj = array.get(ehpda_array, i)
                line.set_x2(e_obj.lvl, time_offset)
                label.set_x(e_obj.lbl, time_offset)
    if i_showNy and show_draws
        label.set_x(ny_lbl, time_offset)

if i_showNy and show_draws
    nmid = time("1", '0000-0001:1234567', "GMT-4")
    var float openprice = 0.0
    if not na(nmid)
        openprice := na(nmid[1]) ? open : math.max(open, openprice)
    if openprice != openprice[1]
        line.new(nmid, openprice, nmid + 86400000, openprice, xloc.bar_time, extend.none, #0064ff, line.style_dotted, 2).set_extend(extend.none)
        label.set_y(ny_lbl, openprice), label.set_text(ny_lbl, "NY Midnight Open | " + str.tostring(math.round_to_mintick(openprice))), label.set_textcolor(ny_lbl, #0098ff), label.set_size(ny_lbl, size.tiny)
    if not na(nmid)
        vl1 = line.new(nmid, high, nmid, low, xloc.bar_time, extend.both, #00b9d0, line.style_solid, 1)
        if line.get_y1(vl1) == line.get_y2(vl1)
            line.delete(vl1)


// --- SMA & EMA Polyline Drawing Engine (Infinite history without dots) ---
sma_out = ta.sma(close, i_smaLen)
ema_out = ta.ema(close, i_emaLen)

var sma_pts = array.new<chart.point>()
var ema_pts = array.new<chart.point>()
var sma_polys = array.new<polyline>()
var ema_polys = array.new<polyline>()

// Global function for drawing polylines seamlessly across arrays
f_draw_poly(array<chart.point> pts, color col, array<polyline> poly_arr) =>
    if pts.size() > 1
        int chunk_size = 9000
        int n_chunks = int(math.ceil(pts.size() / chunk_size))
        if n_chunks > 0
            for i = 0 to n_chunks - 1
                int start_idx = i * chunk_size
                int end_idx = math.min((i + 1) * chunk_size, pts.size() - 1)
                if end_idx > start_idx
                    poly_arr.push(polyline.new(pts.slice(start_idx, end_idx + 1), curved=false, closed=false, xloc=xloc.bar_time, line_color=col, line_style=line.style_solid, line_width=1))

if i_showMas
    if not na(sma_out)
        sma_pts.push(chart.point.from_time(time, sma_out))
        if sma_pts.size() > 25000 // Safely stores up to ~17 continuous days on 1min chart
            sma_pts.shift()
    if not na(ema_out)
        ema_pts.push(chart.point.from_time(time, ema_out))
        if ema_pts.size() > 25000
            ema_pts.shift()

if barstate.islast and i_showMas
    // Clear out the previous frame's polylines
    for p in sma_polys
        polyline.delete(p)
    sma_polys.clear()
    for p in ema_polys
        polyline.delete(p)
    ema_polys.clear()
    
    f_draw_poly(sma_pts, i_smaColor, sma_polys)
    f_draw_poly(ema_pts, i_emaColor, ema_polys)

// Bring back the Price Scale labels using ghost plots!
plot(i_showMas ? sma_out : na, title="SMA", color=i_smaColor, display=display.price_scale)
plot(i_showMas ? ema_out : na, title="EMA", color=i_emaColor, display=display.price_scale)
